    end
    local targetPlr = Auto_Parry.GetTargetPlayer()
    if not targetPlr or not targetPlr:FindFirstChild("HumanoidRootPart") then
        shared.ManualSpamActive = false
        return
    end
    local Velocity = CurrentBall.AssemblyLinearVelocity
    local Zoomies = CurrentBall:FindFirstChild("zoomies")
    if Zoomies then pcall(function() Velocity = Zoomies.VectorVelocity end) end
    local Speed = Velocity.Magnitude
    local rally = CurrentBall:GetAttribute("rally") or 0
    local clashDist = 30
    if rally >= 6 then
        clashDist = math.clamp((Speed * 0.95) + (pingSeconds * Speed * 1.5), 30, 55)
    elseif rally >= 3 then
        clashDist = math.clamp((Speed * 0.75) + (pingSeconds * Speed), 25, 35)
    end
    local DistToMe = (hrp.Position - CurrentBall.Position).Magnitude
    local DistToTarget = (targetPlr.HumanoidRootPart.Position - CurrentBall.Position).Magnitude
    local ballDir = Speed > 1 and Velocity.Unit or Vector3.new(0, -1, 0)
    local toMe = DistToMe > 0.1 and (hrp.Position - CurrentBall.Position).Unit or Vector3.zero
    if DistToMe <= clashDist and DistToTarget <= clashDist and ballDir:Dot(toMe) > -0.2 then
        shared.ManualSpamActive = true
        timeAccumulator += dt
        local packets = math.floor(timeAccumulator * 180)
        if packets > 0 then
            timeAccumulator -= packets / 180
            for _ = 1, math.min(packets, 8) do
                pcall(Auto_Parry.FireParryRemote, true)
            end
        end
    else
        timeAccumulator = 0
        shared.ManualSpamActive = false
    end
end)

