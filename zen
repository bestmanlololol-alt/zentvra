        if LocalPlayer.Character:GetAttribute("Pulsed") then return end

        local ping = math.clamp(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 10, 1, 16)
        local accuracy = _asSpamService(ping, ball)
        if accuracy <= 0 then return end

        local dist = LocalPlayer:DistanceFromCharacter(ball.Position)
        _as.parryCount += 1
        if dist <= accuracy and _as.parryCount > _as.threshold then
            fireParry()
            if _as.animFix then task.spawn(SpamParry_Animation) end
        end
    end)
    if _as.notify then N("Auto Spam", "ON") end
end

