local function _asGetClosest()
    if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then return nil end
    local best, bestDist = nil, math.huge
    local alive = workspace:FindFirstChild("Alive")
    if alive then
        for _, e in pairs(alive:GetChildren()) do
            if e ~= LocalPlayer.Character and e.PrimaryPart then
                local d = (LocalPlayer.Character.PrimaryPart.Position - e.PrimaryPart.Position).Magnitude
                if d < bestDist then bestDist = d; best = e end
            end
        end
    end
    return best, bestDist
end

local function _asSpamService(ping, ball)
    local entity, entityDist = _asGetClosest()
    if not entity or not entity.PrimaryPart then return 0 end

    local vel   = ball.AssemblyLinearVelocity
    local speed = vel.Magnitude
    local dir   = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Unit
    local dot   = dir:Dot(vel.Unit)

    local maxDist = ping + math.min(speed / 6, 255)

    if entityDist > maxDist then return 0 end
    if LocalPlayer:DistanceFromCharacter(ball.Position) > maxDist then return 0 end
    if LocalPlayer:DistanceFromCharacter(entity.PrimaryPart.Position) > maxDist then return 0 end

    local maxSpeed = 5 - math.min(speed / 5, 5)
    local maxDot   = math.clamp(dot, -1, 0) * maxSpeed
    return maxDist - maxDot
end

local function _asStart()
    if _as.conn then _as.conn:Disconnect() end
    _as.enabled = true
    if _as.animFix then task.spawn(SpamParry_Animation) end
    _as.conn = RunService.PreSimulation:Connect(function()
        if not _as.enabled then return end
