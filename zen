local function makeFloat(text, pos, colorOn)
    local b = Instance.new("TextButton", Overlay)
    b.Size = UDim2.new(0, 55, 0, 55)
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    b.Text = text .. "\nOFF"
    b.TextColor3 = Color3.fromRGB(255, 70, 90)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.Visible = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke", b)
    stroke.Color = Color3.fromRGB(255, 70, 90)
    stroke.Thickness = 2
    local drag, start, origin, dragging
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag, start, origin, dragging = true, i.Position, b.Position, false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            if d.Magnitude > 5 then dragging = true end
            if dragging then
                b.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    return b, stroke, function() return dragging end, colorOn or Color3.fromRGB(50, 220, 130)
end

