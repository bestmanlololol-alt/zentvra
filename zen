local hasNotifiedBypassFail = false

function Auto_Parry.FireParryRemote(isSpam)
    if type(Auto_Parry.Parry_Animation) == "function" then
        pcall(Auto_Parry.Parry_Animation)
    end

    local mustUseMouseClick = Config.ParryMethodMode == "click" or not _reverted or next(_reverted) == nil
    if mustUseMouseClick then
        if not hasNotifiedBypassFail and (not _reverted or next(_reverted) == nil) and Config.ParryMethodMode ~= "click" then
            hasNotifiedBypassFail = true
            notify("Bypass not ready — using click. Parry once while alive.", 4)
        end
        fireParryInput()
        return
    end

    local ball = Auto_Parry.Get_Ball()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local finalCamCFrame = cam.CFrame
    local activeTargetPlayer = Auto_Parry.GetTargetPlayer()
    local character = LocalPlayer.Character
    local myHrp = character and character:FindFirstChild("HumanoidRootPart")
    local isTargetTooClose = false

    if Config.ClashTarget and myHrp and activeTargetPlayer and activeTargetPlayer:FindFirstChild("HumanoidRootPart") then
        if (myHrp.Position - activeTargetPlayer.HumanoidRootPart.Position).Magnitude <= 37 then
            isTargetTooClose = true
        end
    end

    if activeTargetPlayer and activeTargetPlayer.Name ~= LocalPlayer.Name and not isTargetTooClose then
        local calculated = Auto_Parry.CalculateParryCFrame(ball, activeTargetPlayer)
        if calculated then
            local pos = typeof(calculated) == "CFrame" and calculated.Position or calculated
            finalCamCFrame = CFrame.lookAt(cam.CFrame.Position, pos)
        end
    end

    local gamePositionsSnapshot = {}
    local aliveFolder = Workspace:FindFirstChild("Alive")
    local deadFolder = Workspace:FindFirstChild("Dead")
    local isLobbyTraining = LocalPlayer:GetAttribute("LobbyTraining") or false

    if isLobbyTraining and deadFolder then
        for _, deadModel in ipairs(deadFolder:GetChildren()) do
            local plrs = Players:GetPlayerFromCharacter(deadModel)
            if plrs and plrs:GetAttribute("LobbyTraining") and deadModel:FindFirstChild("HumanoidRootPart") then
                gamePositionsSnapshot[deadModel.Name] = cam:WorldToScreenPoint(deadModel.HumanoidRootPart.Position)
            end
        end
        for _, trainingTarget in ipairs(CollectionService:GetTagged("LobbyTrainingTarget")) do
            if trainingTarget:IsA("BasePart") then
                gamePositionsSnapshot[trainingTarget.Name] = cam:WorldToScreenPoint(trainingTarget.Position)
            end
        end
    elseif aliveFolder then
        for _, aliveChar in ipairs(aliveFolder:GetChildren()) do
            if aliveChar:IsA("Model") and aliveChar:FindFirstChild("HumanoidRootPart") then
                gamePositionsSnapshot[aliveChar.Name] = cam:WorldToScreenPoint(aliveChar.HumanoidRootPart.Position)
            end
        end
    end

    for remote, originalArgs in pairs(_reverted) do
        if type(originalArgs) == "table" then
            task.spawn(function()
                local finalCoordinates = { cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2 }
                if Config.UseMouseLocation then
                    local mousePos = UserInputService:GetMouseLocation()
                    finalCoordinates = { mousePos.X, mousePos.Y }
                end
                pcall(function()
                    if remote:IsA("RemoteEvent") then
                        remote:FireServer(
                            originalArgs[1],
                            originalArgs[2],
                            _tokenize(originalArgs[2]),
                            isSpam and 0 or 0.5,
                            finalCamCFrame,
                            gamePositionsSnapshot,
                            finalCoordinates,
                            false
                        )
                    end
                end)
            end)
        end
    end
end

function Auto_Parry.Is_Curved(ball)
    local ok, curved = pcall(function()
        if not ball or not ball:IsA("BasePart") then return false end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local vel = ball.AssemblyLinearVelocity
        if vel.Magnitude < 1 then return false end
        local dir = (hrp.Position - ball.Position).Unit
        local dot = vel.Unit:Dot(dir)
        return (dot < 0.75 and dot > -0.6)
    end)
    return ok and curved or false
end

