                Ball.AttributeChanged:Once(function() Main_Parried = false end)
                local Ball_Target = Ball:GetAttribute("target")
                local One_Target = One_Ball and One_Ball:GetAttribute("target")
                local real_pos = GetBallServerPosition(Ball)
                local char = LocalPlayer.Character
                if not char or not char.PrimaryPart then return end
                local Distance = (char.PrimaryPart.Position - real_pos).Magnitude
                local Ping = Stats_ and Stats_["Data Ping"]:GetValue() or 80
                local Ping_Threshold = math.clamp(Ping / 10, 5, 17)
                local Zoomies = Ball:FindFirstChild("zoomies")
                if not Zoomies then return end
                local Speed = Zoomies.VectorVelocity.Magnitude
                if Main_Parried then return end
                local Speed_Divisor_Base = 2.4 + Speed * 0.002
                local Speed_Mult_Divisor = Speed_Divisor_Multiplier
                if RandomParryAccuracyEnabled then
                    Speed_Mult_Divisor = 0.7 + (math.random(1, 100) - 1) * (0.35 / 99)
                end
                local Speed_Divisor = Speed_Divisor_Base * Speed_Mult_Divisor
                local Parry_Accuracy = Ping_Threshold + Speed / Speed_Divisor
                if char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart:FindFirstChild("SingularityCape") then return end
                if Speed <= 0 then return end
                if One_Target == LocalPlayer.Name and IsCurved() then return end
                if detections.infinity and infinity_active then return end
                if detections.timehole and timehole_active then return end
                if Ball_Target == LocalPlayer.Name and Distance <= Parry_Accuracy then
                    local ball_vel = Zoomies.VectorVelocity
                    local ball_speed = ball_vel.Magnitude
                    if ball_speed > 1 then
                        local ball_dir = ball_vel.Unit
                        local to_player = (char.PrimaryPart.Position - real_pos).Unit
                        local approach_dot = to_player:Dot(ball_dir)
                        if approach_dot < 0.3 then return end
                    end
                    if CooldownProtect then
                        pcall(function()
                            local PCD = LocalPlayer.PlayerGui.Hotbar.Block.UIGradient
                            if PCD.Offset.Y < 0.4 then ReplicatedStorage.Remotes.AbilityButtonPress:Fire(); return end
                        end)
                    end
                    local Parry_Time = os.clock()
                    local Time_View = Parry_Time - Last_Parry_Main
                    if Time_View > 0.5 and AnimFix then
                        task.spawn(SpamParry_Animation)
                    end
                    FireParry(CurrentCurveMethod)
                    Last_Parry_Main = Parry_Time
                    Main_Parried = true
                end
                local Last_P = tick()
                repeat RunService.PreSimulation:Wait()
                until (tick() - Last_P) >= 1 or not Main_Parried
                Main_Parried = false
            end
        end)
    else
        if Connections["Auto Parry"] then
            Connections["Auto Parry"]:Disconnect()
            Connections["Auto Parry"] = nil
        end
        Main_Parried = false
    end
    N("Auto Parry", v and "ON" or "OFF")
end})
