local function GetParryData(Parry_Type)
    local Camera = workspace.CurrentCamera
    local Events = {}
    local Players_Screen_Positions = {}
    local Vec2MouseLoc
    local isMobile_ = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    if not isMobile_ then
        local ML = UserInputService:GetMouseLocation()
        Vec2MouseLoc = {ML.X, ML.Y}
    else
        Vec2MouseLoc = {Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2}
    end
    local aliveFolder = workspace:FindFirstChild("Alive")
    if aliveFolder then
        for _, v in pairs(aliveFolder:GetChildren()) do
            if v ~= LocalPlayer.Character then
                local worldPos = v.PrimaryPart and v.PrimaryPart.Position or false
                if worldPos then
                    local screenPos, isOnScreen = Camera:WorldToScreenPoint(worldPos)
                    if isOnScreen then
                        Players_Screen_Positions[v] = Vector2.new(screenPos.X, screenPos.Y)
                    end
                    Events[tostring(v)] = screenPos
                end
            end
        end
    end
    if Parry_Type == "Camera" then
        return {0, Camera.CFrame, Events, Vec2MouseLoc}
    elseif Parry_Type == "Normal" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Vector3.new(0, 0, -1) * 9e9), Events, Vec2MouseLoc}
    elseif Parry_Type == "Accelerated" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Vector3.new(0, 5, 0)), Events, Vec2MouseLoc}
    elseif Parry_Type == "Up" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Camera.CFrame.UpVector * 10000), Events, Vec2MouseLoc}
    elseif Parry_Type == "Down" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Vector3.new(0, -5, 0) * 9e20), Events, Vec2MouseLoc}
    elseif Parry_Type == "Left" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position - Camera.CFrame.RightVector * 9e20), Events, Vec2MouseLoc}
    elseif Parry_Type == "Right" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Camera.CFrame.RightVector * 9e20), Events, Vec2MouseLoc}
    elseif Parry_Type == "Backwards" then
        local char = LocalPlayer.Character
        return {0, CFrame.new(Camera.CFrame.Position, char.HumanoidRootPart.Position + (char.HumanoidRootPart.Position - (Camera.CFrame.Position + Camera.CFrame.LookVector * 100)).Unit * 10000000 + Vector3.new(0, 1000, 0)), Events, Vec2MouseLoc}
    elseif Parry_Type == "Straight" then
        local char = LocalPlayer.Character
        return {0, CFrame.new(char.HumanoidRootPart.Position, char.HumanoidRootPart.Position + char.HumanoidRootPart.CFrame.LookVector), Events, Vec2MouseLoc}
    elseif Parry_Type == "Behind" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + -Camera.CFrame.LookVector * 9e20), Events, Vec2MouseLoc}
    elseif Parry_Type == "Random" then
        return {0, CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position - Camera.CFrame.LookVector * 9e20 + Vector3.new(math.random(-9e20,9e20), math.random(-9e20,9e20), math.random(-9e20,9e20))), Events, Vec2MouseLoc}
    elseif Parry_Type == "RandomTarget" then
        local candidates = {}
        local aliveF = workspace:FindFirstChild("Alive")
        if aliveF then
            for _, v in pairs(aliveF:GetChildren()) do
                if v ~= LocalPlayer.Character and v.PrimaryPart then
                    local sp, on = Camera:WorldToScreenPoint(v.PrimaryPart.Position)
                    if on then table.insert(candidates, {character=v, screenXY={sp.X, sp.Y}}) end
                end
            end
        end
        if #candidates > 0 then
            local pick = candidates[math.random(1, #candidates)]
            return {0, CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position, pick.character.PrimaryPart.Position), Events, pick.screenXY}
        else
            return {0, Camera.CFrame, Events, {Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2}}
        end
    end
    return {0, Camera.CFrame, Events, Vec2MouseLoc}
end

