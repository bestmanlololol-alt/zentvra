if shared._PhysicsParryBind then shared._PhysicsParryBind:Disconnect() end
shared._PhysicsParryBind = RunService.RenderStepped:Connect(function()
    if not shared._ZentVraRunning or not Config.AutoParry then return end
    local character = LocalPlayer.Character
    if not character or not character.PrimaryPart then return end
    local hrp = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    if not hrp then return end

    local balls = SafeGetBalls()
    if #balls == 0 then return end

    local playerPos = hrp.Position
    local now = os.clock()
    local parryMode = Config.ParryMode or "Curve"
    local userScale = (Config.DistanceTiming or 100) / 100

    local myTargeted = {}
    for _, b in ipairs(balls) do
        if b and b.Parent then
            local t = b:GetAttribute("target") or b:GetAttribute("Target")
            if tostring(t or "") == LocalPlayer.Name then
                table.insert(myTargeted, b)
            end
        end
    end

    local multiBurst = 1
    if #myTargeted >= 2 then
        for i = 1, #myTargeted do
            local a = myTargeted[i]
            if (playerPos - a.Position).Magnitude < 25 then
                local group = 1
                for j = 1, #myTargeted do
                    if i ~= j and (a.Position - myTargeted[j].Position).Magnitude < 8 then
                        group += 1
                    end
                end
                if group > multiBurst then multiBurst = group end
            end
        end
    end

    for _, Ball in ipairs(balls) do
        if not Ball or not Ball.Parent then continue end
        local ballPos = Ball.Position
        local Distance = (playerPos - ballPos).Magnitude
        local Velocity = Vector3.zero
        local Zoomies = Ball:FindFirstChild("zoomies")
        if Zoomies then
            local s, v = pcall(function() return Zoomies.VectorVelocity end)
            if s and v then Velocity = v end
        end
        if Velocity == Vector3.zero then
            Velocity = Ball.AssemblyLinearVelocity
        end
        local Speed = Velocity.Magnitude
        local ballDirection = Speed > 1 and Velocity.Unit or Vector3.new(0, -1, 0)
        local toPlayer = Distance > 0.1 and (playerPos - ballPos).Unit or Vector3.zero
        local dotProduct = ballDirection:Dot(toPlayer)
        local targetAttr = Ball:GetAttribute("target") or Ball:GetAttribute("Target")
        local isTargetingMe = (tostring(targetAttr or "") == LocalPlayer.Name)

        if Config.SoccerMode then
            isTargetingMe = (dotProduct > -0.15 or Distance <= 16)
        end
        if not isTargetingMe then
            parryLocked[Ball] = false
            lockTime[Ball] = 0
            continue
        end

        if parryLocked[Ball] then
            local cd = math.clamp(4.9 - (Speed * 0.01), 0.7, 0.85)
            if multiBurst > 1 then cd = 0.46 end
            if now - (lockTime[Ball] or 0) >= cd then
                parryLocked[Ball] = false
            else
                continue
            end
        end

        local reachTime = Distance / math.max(Speed, 1)
        local triggerParry = false
        local emergencyDist = SafeGetEmergencyDistance(Speed) + 2.5

        if reachTime <= 0.05 then triggerParry = true end

        if Speed > 490 then
            if (reachTime <= pingSeconds + 0.34 or Distance <= emergencyDist) then
                triggerParry = true
            end
        else
            local isBallCurvingReal = (dotProduct < 0.75 and dotProduct > -0.6)
            local isBallDriftingOutside = (not isBallCurvingReal) and (dotProduct < 0.45)
            if parryMode == "Curve" then
                local maxCurveDist = (Speed > 400) and 43 or 23
                if Distance <= emergencyDist and Distance <= maxCurveDist then
                    triggerParry = true
                else
                    local lateral = Velocity - (Velocity.Unit:Dot(toPlayer) * Velocity.Unit)
                    local isDropping = ballDirection.Y < -0.15
                    local pingBuffer = pingSeconds * Speed * 1.18
                    local base = (12.5 + (Speed * (Config.wowcurve or 0.35))) - (lateral.Magnitude * 0.13) + pingBuffer
                    local strikeZone = math.clamp(base, 18, 135) * userScale * (tonumber(Config.huh) or 1)
                    local drifting = (not isDropping) and (dotProduct < 0.45)
                    if Distance <= strikeZone or reachTime <= 0.08 then
                        if (dotProduct > -0.15 or Distance <= 22) and (not drifting or Distance <= 15) then
                            triggerParry = true
                        end
                    end
                end
            else
                local zone = math.clamp(8.5 + (Speed * 0.3), 8.5, 68) * userScale
                if (Distance <= zone or reachTime <= 0.05) and (not isBallDriftingOutside or Distance <= 13) then
                    triggerParry = true
                end
            end
        end

        if triggerParry and (now - lastParryTime) >= 0.003 then
            local burst = math.max((Speed > 2000) and 3 or 1, multiBurst)
            for _ = 1, burst do
                pcall(Auto_Parry.FireParryRemote, false)
            end
            lastParryTime = now
            lastHitTicks[Ball] = now
            parryLocked[Ball] = true
            lockTime[Ball] = now
        end
    end
end)

