-- Lerp + curved detection helpers
local lerp_radians_ = 0
local last_warping_ = tick()
local last_ball_pos_ = nil
local last_time_ = os.clock()

local function LinearInterp(a, b, t)
    return a + (b - a) * t
end

local function IsCurved()
    local ball = GetBall()
    if not ball then last_ball_pos_ = nil; return false end
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return false end

    local current_pos = GetBallServerPosition(ball)
    local current_time = os.clock()

    if not last_ball_pos_ then
        last_ball_pos_ = current_pos
        last_time_ = current_time
        return false
    end

    local delta_time = current_time - last_time_
    if delta_time <= 0 then return false end

    local frame_dist = (current_pos - last_ball_pos_).Magnitude
    local local_velocity = (current_pos - last_ball_pos_) / delta_time
    last_ball_pos_ = current_pos
    last_time_ = current_time

    local speed = frame_dist / delta_time
    if speed < 1 then return false end

    local distance = (char.PrimaryPart.Position - current_pos).Magnitude
    local pings = Stats_ and Stats_["Data Ping"]:GetValue() or 80
    local ping_threshold = math.clamp(pings / 10, 5, 17)
    local ap_dist = 18 + ping_threshold

    local speed_factor = speed / 250
    local direction_to_player = (char.PrimaryPart.Position - current_pos).Unit
    local ball_direction = local_velocity.Unit

    local dot = direction_to_player:Dot(ball_direction)
    local clamped_dot = math.clamp(dot, -1, 1)
    local radians = math.asin(clamped_dot)

    lerp_radians_ = LinearInterp(lerp_radians_, radians,
        math.clamp(0.80 + speed_factor * 0.05, 0.80, 0.97)
    )

    if math.abs(lerp_radians_) < (0.02 / speed_factor) then
        last_warping_ = tick()
    end

    local reach_time = (distance / speed) - (pings / 1000)

    if distance <= ap_dist then
        if (tick() - last_warping_) < (reach_time / (1.2 + speed_factor * 0.2)) then
            return true
        end
        if dot < 0.9 and speed > 10 then return true end
    end

    return false
end

