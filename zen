local St = Tabs.Status:AddLeftGroupbox("Live")
local L_Speed = St:AddLabel("Ball Speed: 0.00")
local L_Time = St:AddLabel("Time To Hit: 0.000s")
local L_Target = St:AddLabel("Target: None")
local L_Near = St:AddLabel("Nearest: None")
local L_Far = St:AddLabel("Farthest: None")
local L_Curve = St:AddLabel("wowcurve: 0.33")
task.spawn(function()
    while shared._ZentVraRunning do
        RunService.RenderStepped:Wait()
        pcall(function()
            local ball = Auto_Parry.Get_Ball()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if ball and hrp then
                local vel = ball.AssemblyLinearVelocity
                local z = ball:FindFirstChild("zoomies")
                if z then pcall(function() vel = z.VectorVelocity end) end
                local speed = vel.Magnitude
                local reach = (hrp.Position - ball.Position).Magnitude / math.max(speed, 1)
                L_Speed:SetText(string.format("Ball Speed: %.2f", speed))
                L_Time:SetText(string.format("Time To Hit: %.3fs", reach))
            else
                L_Speed:SetText("Ball Speed: 0.00")
                L_Time:SetText("Time To Hit: 0.000s")
            end
            local t = shared.Clicked_Target_Name or (Auto_Parry.GetTargetPlayer() and Auto_Parry.GetTargetPlayer().Name) or "None"
            L_Target:SetText("Target: " .. tostring(t))
            local n, f = targetDistanceSolver("Nearest"), targetDistanceSolver("Farest")
            L_Near:SetText("Nearest: " .. (n and n.Name or "None"))
            L_Far:SetText("Farthest: " .. (f and f.Name or "None"))
            L_Curve:SetText(string.format("wowcurve: %.2f", Config.wowcurve or 0.33))
        end)
    end
end)

