AutoPlayModule.lerp     = function(s,f,a) return s+(f-s)*a end
AutoPlayModule.quadratic = function(s,m,f,a) return AutoPlayModule.lerp(AutoPlayModule.lerp(s,m,a),AutoPlayModule.lerp(m,f,a),a) end

AutoPlayModule.getControlPoint = function(start,finish)
    local mid=(start+finish)*0.5; local diff=start-finish
    if diff.Magnitude<5 then return finish end
    local theta=math.atan2(diff.Z,diff.X); local offLen=diff.Magnitude*AutoPlayModule.CONFIG.OFFSET_FACTOR
    local f=mid+Vector3.new(math.cos(theta+math.pi/2),0,math.sin(theta+math.pi/2))*offLen
    local s=mid+Vector3.new(math.cos(theta-math.pi/2),0,math.sin(theta-math.pi/2))*offLen
    return ((f-mid):Dot(start-mid)<0) and f or s
end

AutoPlayModule.getCurve = function(start,finish,delta)
    AutoPlayModule.ELAPSED+=delta
    local t=math.clamp(AutoPlayModule.ELAPSED/AutoPlayModule.CONFIG.MOVEMENT_DURATION,0,1)
    if t>=1 then if (start-finish).Magnitude>=10 then AutoPlayModule.ELAPSED=0 end; AutoPlayModule.CONTROL_POINT=nil; return finish end
    if not AutoPlayModule.CONTROL_POINT then AutoPlayModule.CONTROL_POINT=AutoPlayModule.getControlPoint(start,finish) end
    if not AutoPlayModule.CONTROL_POINT then return finish end
    return AutoPlayModule.quadratic(start,AutoPlayModule.CONTROL_POINT,finish,t)
end

